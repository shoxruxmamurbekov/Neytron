# Muhit: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL ulanish satri (docker-compose uchun: postgresql://neytron:neytron@localhost:5432/neytron?schema=public)
DATABASE_URL=postgresql://neytron:neytron@localhost:5432/neytron?schema=public

# Vergul bilan ajratilgan ruxsat etilgan frontend manzillari
CORS_ORIGINS=http://localhost:5173

# Swagger UI (production'da standart bo'yicha o'chiq)
SWAGGER_ENABLED=true

# Rate limiting: TTL millisekundda, LIMIT — shu oraliqda so'rovlar soni
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# JWT: kamida 32 belgi. Haqiqiy qiymatlarni faqat muhit o'zgaruvchisi sifatida saqlang, repozitoriyaga yozmang.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
